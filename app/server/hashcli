#!/bin/bash
# hashcli - File hash calculator for fnOS
# Usage: hashcli [-a algo] [-r] [-c expected] [-j] <path>
#   -a  Algorithm: sha256 (default), md5, sha1, sha512, blake3, all
#   -r  Recursive directory processing
#   -c  Expected hash for verification
#   -j  JSON output

ALGO="sha256"
RECURSIVE=false
EXPECTED=""
JSON=false

# 脚本所在目录，用于定位打包进 bin/ 的 b3sum 二进制
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# 单个复用的临时文件，用于把子进程的 stderr 与 stdout 分开收集。
# 每算一个文件新建一个临时文件在大目录下开销可观，故只建一次。
ERR_TMP="$(mktemp "${TMPDIR:-/tmp}/hashcli.XXXXXX")"
trap 'rm -f "$ERR_TMP"' EXIT INT TERM

# 错误信息一律交给 python 的 json.dumps 转义：路径里的引号/反斜杠/换行
# 直接 printf 进 JSON 字面量会产出非法 JSON（-j 的调用方无从解析）
json_error() {
    python3 -c 'import sys, json
print(json.dumps({"success": False, "error": sys.argv[1]}, ensure_ascii=False))' "$1"
}

usage() {
    echo "Usage: $(basename "$0") [-a algo] [-r] [-c expected] [-j] <path>" >&2
    echo "  -a  sha256 (default), md5, sha1, sha512, blake3, all" >&2
    echo "  -r  Recursive directory processing" >&2
    echo "  -c  Verify against expected hash" >&2
    echo "  -j  JSON output" >&2
    exit 1
}

while getopts ":a:rc:j" opt; do
    case $opt in
        a) ALGO="$OPTARG" ;;
        r) RECURSIVE=true ;;
        c) EXPECTED="$OPTARG" ;;
        j) JSON=true ;;
        :) echo "Error: option -$OPTARG requires an argument" >&2; usage ;;
        \?) echo "Error: unknown option -$OPTARG" >&2; usage ;;
    esac
done
shift $((OPTIND - 1))

TARGET="${1:-}"
[ -z "$TARGET" ] && usage

if [ ! -e "$TARGET" ]; then
    if $JSON; then
        json_error "Path not found: $TARGET"
    else
        echo "Error: path not found: $TARGET" >&2
    fi
    exit 1
fi

NO_PERM="无读取权限，请先至应用设置内添加文件夹读取权限"

if [ -d "$TARGET" ] && [ ! -r "$TARGET" ]; then
    if $JSON; then
        json_error "$NO_PERM"
    else
        echo "Error: $NO_PERM" >&2
    fi
    exit 1
fi

hash_cmd() {
    case "$1" in
        sha256) echo "sha256sum" ;;
        md5)    echo "md5sum"    ;;
        sha1)   echo "sha1sum"   ;;
        sha512) echo "sha512sum" ;;
        blake3) echo "${SCRIPT_DIR}/bin/b3sum" ;;
        *)      echo ""          ;;
    esac
}

# 结果通过全局变量返回而非 stdout：命令替换会开子 shell，
# 在里面设置的错误信息传不回调用方
HASH_VAL=""
HASH_ERR=""
compute_hash() {
    local file="$1" algo="$2" cmd out rc
    HASH_VAL=""
    HASH_ERR=""
    cmd=$(hash_cmd "$algo")
    if [ ! -r "$file" ]; then
        HASH_ERR="$NO_PERM"
        return 1
    fi
    # stderr 单独收集：合并进 stdout 的话，命令成功但打了 warning 时
    # warning 会排在摘要行前面，被下面的取首字段当成哈希值
    out=$("$cmd" -- "$file" 2>"$ERR_TMP")
    rc=$?
    if [ $rc -ne 0 ]; then
        HASH_ERR="$(cat "$ERR_TMP")"
        HASH_ERR="${HASH_ERR:-$cmd exited with status $rc}"
        return 1
    fi
    # 文件名含 \ 或换行时，GNU *sum（含打包的 b3sum）会转义文件名并在整行
    # 开头加一个 \ 作标记。不剥掉的话哈希值会多一个前导反斜杠，既入库也参与
    # 校验比对，导致这类文件永远校验失败。
    [ "${out:0:1}" = '\' ] && out="${out:1}"
    HASH_VAL="${out%% *}"   # "<hash>  <file>" 取首字段
    if [ -z "$HASH_VAL" ]; then
        HASH_ERR="$cmd produced no output"
        return 1
    fi
    return 0
}

if [ "$ALGO" = "all" ]; then
    ALGOS=(sha256 md5 sha1 sha512 blake3)
else
    # 提前校验算法名，否则会静默输出一堆空哈希且退出码为 0
    if [ -z "$(hash_cmd "$ALGO")" ]; then
        if $JSON; then
            json_error "Unknown algorithm: $ALGO"
        else
            echo "Error: unknown algorithm: $ALGO" >&2
        fi
        exit 1
    fi
    ALGOS=("$ALGO")
fi

# Collect files
FILES=()
if [ -f "$TARGET" ]; then
    FILES=("$TARGET")
elif [ -d "$TARGET" ]; then
    # -H 只对命令行上的 TARGET 解引用：TARGET 本身是软链目录时要进去（否则
    # find 直接得到 0 个文件，而服务端的 os.walk 会照常遍历，两边结论相反），
    # 但树内部的软链不跟随，与 os.walk 默认的 followlinks=False 保持一致。
    DEPTH=()
    $RECURSIVE || DEPTH=(-maxdepth 1)
    while IFS= read -r -d '' f; do FILES+=("$f"); done \
        < <(find -H "$TARGET" "${DEPTH[@]}" -type f -print0 | sort -z)
fi

if [ ${#FILES[@]} -eq 0 ]; then
    if $JSON; then
        echo '{"success":true,"results":[]}'
    else
        echo "No files found."
    fi
    exit 0
fi

if $JSON; then
    # Use Python -c (not heredoc) so stdin remains available for the pipe.
    # 字段用 NUL 分隔而非 TAB/换行：文件名里合法地可以出现制表符和换行，
    # 用它们做分隔符会让整条记录的字段整体错位（算法列被填进文件名、
    # 哈希列被填进算法……），且错位后字段数不足的记录会被静默丢弃。
    # NUL 是路径里唯一不可能出现的字节，因此是安全的分隔符。
    {
        for file in "${FILES[@]}"; do
            for algo in "${ALGOS[@]}"; do
                compute_hash "$file" "$algo"
                printf '%s\0%s\0%s\0%s\0%s\0' "$file" "$algo" "$HASH_VAL" "$EXPECTED" "$HASH_ERR"
            done
        done
    } | python3 -c "
import sys, json
fields = sys.stdin.buffer.read().split(b'\0')
if fields and fields[-1] == b'':
    fields.pop()   # 末尾分隔符留下的空串，不是一个字段
results = []
failed = False
for i in range(0, len(fields) - len(fields) % 5, 5):
    # 文件名未必是合法 UTF-8，用 replace 兜底，保证总能产出合法 JSON
    file_path, algo, hash_val, expected, err = (
        f.decode('utf-8', 'replace') for f in fields[i:i + 5])
    entry = {'file': file_path, 'algo': algo, 'hash': hash_val or None}
    if err:
        entry['error'] = err
        failed = True
    if expected:
        entry['verified'] = (hash_val.lower() == expected.lower())
        entry['expected'] = expected
        if not entry['verified']:
            failed = True   # 与文本模式一致：校验不通过也以非 0 退出
    results.append(entry)
print(json.dumps({'success': True, 'results': results}, ensure_ascii=False))
sys.exit(1 if failed else 0)
"
    # 管道左侧在子 shell 中运行，失败标记取自 python 的退出码
    EXIT_CODE=$?
else
    EXIT_CODE=0
    for file in "${FILES[@]}"; do
        for algo in "${ALGOS[@]}"; do
            if ! compute_hash "$file" "$algo"; then
                echo "Error: $file ($algo): $HASH_ERR" >&2
                EXIT_CODE=1
                continue
            fi
            if [ -n "$EXPECTED" ]; then
                # *sum 输出小写，粘贴来的校验值常为大写，比对忽略大小写
                [ "${HASH_VAL,,}" = "${EXPECTED,,}" ] && status="OK" || status="FAIL"
                [ "$status" = "FAIL" ] && EXIT_CODE=1
                printf "%-8s  %s  %s  [%s]\n" "$algo" "$HASH_VAL" "$file" "$status"
            else
                printf "%-8s  %s  %s\n" "$algo" "$HASH_VAL" "$file"
            fi
        done
    done
fi

exit $EXIT_CODE
