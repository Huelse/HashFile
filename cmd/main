#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

# TRIM_PKGVAR 由 fnOS 注入；万一没有，也别把日志静默写到 /info.log 去。
# :? 的报错要留在 stderr 上可见，只把 mkdir 自己的噪音吞掉。
: "${TRIM_PKGVAR:?TRIM_PKGVAR is not set}"
mkdir -p "${TRIM_PKGVAR}" 2>/dev/null

# write the command to start your program here
CMD="python3 ${TRIM_APPDEST}/server/server.py"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

start_process() {
    if status; then
        return 0
    fi

    log_msg "Starting process ... (TRIM_APPDEST=${TRIM_APPDEST})"
    if [ ! -f "${TRIM_APPDEST}/server/server.py" ]; then
        log_msg "ERROR: server.py not found at ${TRIM_APPDEST}/server/server.py"
        exit 1
    fi

    # run cmd to start process
    # exec 掉包装 shell：不加的话 $! 是 bash 的 pid，bash 未必会把自己换成
    # python（只是常见优化，不是保证），那样 stop 就只杀到包装进程，
    # 真正占着 socket 的 python 会被孤儿化，下次 start 绑不上端口
    bash -c "exec ${CMD}" >> "${LOG_FILE}" 2>&1 &
    local pid=$!
    printf "%s" "${pid}" > "${PID_FILE}"

    # 拉起 ≠ 起来了：server.py 可能立刻退出（socket 未配置、绑定失败…）。
    # 不确认的话 fnOS 会显示"已启动"，用户只看到一个打不开的应用。
    sleep 1
    if ! check_process "${pid}"; then
        log_msg "ERROR: process exited immediately after start; see ${LOG_FILE}"
        rm -f "${PID_FILE}"
        return 1
    fi
    log_msg "started (pid=${pid})"
    return 0
}

stop_process() {
    log_msg "Stopping process ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        
        log_msg "pid=${pid}"
        if ! check_process "${pid}"; then
            # process not exist, delete pidfile
            rm -f "${PID_FILE}"
            log_msg "remove pid file 1"
            return
        fi

        log_msg "send TERM signal to PID:${pid}..."
        kill -TERM ${pid} >> ${LOG_FILE} 2>&1

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done

        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}"
            sleep 1
            # KILL 之后还活着说明真的停不下来：如实上报，并且**保留** pidfile，
            # 否则就再也追踪不到那个还占着 socket 的进程了
            if check_process "${pid}"; then
                log_msg "ERROR: process ${pid} survived SIGKILL"
                return 1
            fi
            rm -f "${PID_FILE}"
        else
            log_msg "process killed... "
            # 干净停止后同样要清掉 pidfile，否则要等到下次 status 才被回收
            rm -f "${PID_FILE}"
        fi
    fi

    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0  # process exist
    else
        return 1  # process not exist
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            # Process is not running but pidfile exists - clean it up
            rm -f "${PID_FILE}"
        fi    
    fi

    return 1
}

case $1 in
start)
    # run start command. exit 0 if success, exit 1 if failed
    start_process || exit 1
    ;;
stop)
    # run stop command. exit 0 if success, exit 1 if failed
    stop_process || exit 1
    ;;
status)
    # check application status command. exit 0 if running, exit 3 if not running
    if status; then 
        exit 0
    else 
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac